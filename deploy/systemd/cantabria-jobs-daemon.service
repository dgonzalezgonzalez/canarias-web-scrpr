[Unit]
Description=Cantabria Jobs Nightly Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/canarias-cantabria-unis-ml
EnvironmentFile=-/opt/canarias-cantabria-unis-ml/.env
ExecStart=/opt/canarias-cantabria-unis-ml/.venv/bin/python -m src.canarias_uni_ml.cli jobs daemon --region cantabria --window-start 22:00 --window-end 07:30 --timezone Europe/Madrid --strategy scrape --limit-per-source 200 --cooldown-minutes 30 --stagnation-cycles 6 --fail-on-stagnation
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
