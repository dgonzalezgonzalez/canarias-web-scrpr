[Unit]
Description=Cantabria Jobs Nightly Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/canarias-cantabria-unis-ml
EnvironmentFile=-/opt/canarias-cantabria-unis-ml/.env
Environment=PYTHONUNBUFFERED=1
# EMCAN is the cleared official default. Add --sources trabajocantabria only
# after the source terms have been reviewed and permission is documented.
ExecStart=/opt/canarias-cantabria-unis-ml/.venv/bin/python -m src.canarias_uni_ml.cli jobs daemon --region cantabria --sources emcan --window-start 22:00 --window-end 07:30 --timezone Europe/Madrid --strategy scrape --limit-per-source 200 --cooldown-minutes 1440 --stagnation-cycles 1 --fail-on-stagnation
Restart=on-failure
RestartSec=60
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
